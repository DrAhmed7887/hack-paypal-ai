# Variable names only. The app reads the environment: export these in your shell
# (e.g. `set -a; . ./.env; set +a` from a git-ignored .env copy). Never commit real values.
# PayPal: a SANDBOX REST app (US business account) with Invoicing switched on
# before the first token request (tokens keep old permissions for up to 9 h).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Fireworks AI key for the bill reader and the plain-language summary.
FIREWORKS_API_KEY=

# Optional (defaults shown)
BILLCHECK_DAILY_CAP_USD=2.00
BILLCHECK_AUDITS_PER_HOUR=20
# Behind a proxy or tunnel: the header it sets with the client IP (e.g. X-Forwarded-For).
BILLCHECK_CLIENT_IP_HEADER=
# Allowed frame ancestors for embedding (e.g. https://huggingface.co).
BILLCHECK_FRAME_ANCESTORS=
